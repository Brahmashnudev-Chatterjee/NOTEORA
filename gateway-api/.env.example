PORT=5100
DATABASE_URL=postgresql://gateway_test:replace-me@127.0.0.1:5432/noteora_gateway_test?schema=gateway
GATEWAY_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GATEWAY_WEBHOOK_ENCRYPTION_KEY=replace-with-a-separate-random-encryption-key
GATEWAY_CLIENT_URL=http://localhost:5173,http://localhost:5174
# Trusted internal marketplace origin for live administrator session/role checks.
MARKETPLACE_AUTH_URL=http://127.0.0.1:5000
# Default zero. Set only to your known reverse-proxy hop count.
TRUST_PROXY_HOPS=0
# Optional; must be a loopback database name ending in _test.
TEST_GATEWAY_DATABASE_URL=
