PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/noteora
DATABASE_URL=postgresql://noteora_dev:change-me@127.0.0.1:5432/noteora?schema=marketplace
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret
UPI_GATEWAY_URL=https://payments.example.com
UPI_GATEWAY_ENV=sandbox
UPI_GATEWAY_LIVE_API_KEY=
UPI_GATEWAY_LIVE_API_SECRET=
UPI_GATEWAY_SANDBOX_API_KEY=
UPI_GATEWAY_SANDBOX_API_SECRET=
UPI_GATEWAY_LIVE_WEBHOOK_SECRET=
UPI_GATEWAY_SANDBOX_WEBHOOK_SECRET=

# Development writes private .dev-mail JSON files; production must use SMTP.
EMAIL_TRANSPORT=development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private local PDFs/thumbnails/previews. Never serve this directory statically.
PRIVATE_UPLOAD_DIR=uploads
