{
  "name": "noteora-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postinstall": "prisma generate --schema ../database/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema ../database/prisma/schema.prisma",
    "start": "node dist/index.js",
    "test": "vitest run --exclude src/postgres.integration.test.ts",
    "test:postgres": "prisma generate --schema ../database/prisma/schema.prisma && vitest run src/postgres.integration.test.ts",
    "db:export": "node scripts/mongo-export.mjs",
    "db:migrate:dry": "node scripts/migrate-mongodb-to-postgres.mjs --dry-run",
    "db:migrate": "node scripts/migrate-mongodb-to-postgres.mjs",
    "workers": "tsx src/workers/index.ts",
    "db:seed": "tsx scripts/seed-prisma.ts",
    "db:verify": "tsx scripts/verify-postgres.ts",
    "test:auth-browser": "node -e \"if(process.env.RUN_AUTH_BROWSER!=='1')throw new Error('Set RUN_AUTH_BROWSER=1')\" && vitest run src/auth.browser.test.ts",
    "test:marketplace-browser": "node -e \"if(process.env.RUN_MARKETPLACE_BROWSER!=='1')throw new Error('Set RUN_MARKETPLACE_BROWSER=1')\" && vitest run src/marketplace.browser.test.ts",
    "test:financial-browser": "node -e \"if(process.env.RUN_FINANCIAL_BROWSER!=='1')throw new Error('Set RUN_FINANCIAL_BROWSER=1')\" && vitest run src/financial.browser.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "nodemailer": "10.5.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^10.2.1",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "vite": "7.3.7"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
